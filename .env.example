# ==============================================================================
# Base de datos (Neon Postgres) — OBLIGATORIA en producción
# ==============================================================================
# Única URL necesaria: la del connection pooler (-pooler) de Neon.
# `pnpm db:*` deriva la conexión directa para migraciones quitando "-pooler".
# Recomendado en serverless: &connection_limit=5 para acotar conexiones por instancia.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/certifox?sslmode=require&connection_limit=5"
# Opcional: réplica de lectura de Neon para listados pesados.
# DATABASE_READ_REPLICA_URL=""
# Opcional: solo si tu proveedor no es Neon y el host directo no se puede derivar.
# DIRECT_URL=""

# ==============================================================================
# Autenticación (Better Auth) — OBLIGATORIAS en producción
# ==============================================================================
# Generar con: openssl rand -base64 32   (mínimo 32 caracteres)
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
# Orígenes extra separados por coma (previews, dominios propios de clientes).
# TRUSTED_ORIGINS="https://certifox-git-main.vercel.app"

# ==============================================================================
# Multi-tenant
# ==============================================================================
# Dominio raíz: <slug>.ROOT_DOMAIN muestra el catálogo de esa organización.
# También habilita cookies de sesión compartidas entre subdominios.
# ROOT_DOMAIN="certifox.pe"
# URL pública usada en emails y en el QR de los PDFs (por defecto BETTER_AUTH_URL).
# NEXT_PUBLIC_APP_URL="https://certifox.pe"

# ==============================================================================
# Cloudflare R2 (archivos) — sin estas variables, en desarrollo se usa un modo local
# ==============================================================================
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Bucket PÚBLICO (portadas, avatares, logos) servido por NEXT_PUBLIC_MEDIA_URL
R2_BUCKET="certifox-media"
# Bucket PRIVADO (PDFs de certificados, videos, adjuntos) — SIN dominio público
R2_PRIVATE_BUCKET="certifox-private"
NEXT_PUBLIC_MEDIA_URL="https://media.certifox.pe"

# ==============================================================================
# Rate limit distribuido (Upstash Redis) — sin esto, el límite es por instancia
# ==============================================================================
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ==============================================================================
# Jobs y emails
# ==============================================================================
# Protege /api/internal/cron (Vercel Cron envía "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=""
# Emails transaccionales (Resend). Sin clave, los emails solo se registran en el log.
RESEND_API_KEY=""
EMAIL_FROM="Certifox <no-reply@certifox.pe>"

# ==============================================================================
# Observabilidad
# ==============================================================================
LOG_LEVEL="info"
