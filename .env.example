# ==============================================================================
# Base de datos (Neon Postgres)
# ==============================================================================
# Única URL necesaria: la del connection pooler (-pooler) de Neon.
# Los comandos `pnpm db:*` derivan la conexión directa para migraciones
# quitando "-pooler" del host. Solo define DIRECT_URL si usas otro proveedor
# cuyo host directo no se pueda derivar.
DATABASE_URL="postgresql://user:password@ep-example-pooler.us-east-1.aws.neon.tech/certifox?sslmode=require"

# ==============================================================================
# Autenticación (Better Auth)
# ==============================================================================
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ==============================================================================
# Almacenamiento de imágenes (Cloudflare R2 - API compatible S3)
# ==============================================================================
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET="certifox-media"
NEXT_PUBLIC_MEDIA_URL="https://media.certifox.edu"

# ==============================================================================
# Flujo de pago manual (Yape / Plin / Transferencia / WhatsApp)
# ==============================================================================
NEXT_PUBLIC_PAYMENT_WHATSAPP="51999999999"
